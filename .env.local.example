# Supabase (HongHub/유쓰레드/유쇼츠와 공유하는 프로젝트: iwxpjnwktxpscoktfpyl)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth 토큰(Threads 액세스 토큰 등) 암호화 키 — openssl rand -base64 32 로 생성
VAULT_MASTER_KEY=

# Threads(Meta) 앱 — 유쓰레드와 같은 Meta 앱을 재사용하되, Threads 제품 설정에
# https://u-one-shot.vercel.app/api/auth/threads/callback 을 Redirect URI로 추가해야 함
THREADS_APP_ID=
THREADS_APP_SECRET=
NEXT_PUBLIC_THREADS_APP_ID=

# Facebook/Instagram(Meta) 앱 — Threads와 별도 Meta 앱이거나, 같은 앱에 Facebook Login +
# Instagram Graph API 제품을 추가해도 됨. Redirect URI:
# https://u-one-shot.vercel.app/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# X(Twitter) 개발자 앱 — 미디어 업로드는 유료 API 티어 필요. Redirect URI:
# https://u-one-shot.vercel.app/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# YouTube — Supabase 로그인용 Google과 별개의 Google Cloud OAuth 클라이언트(YouTube Data API v3
# 활성화 필요). Redirect URI: https://u-one-shot.vercel.app/api/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
NEXT_PUBLIC_YOUTUBE_CLIENT_ID=

# TikTok for Developers 앱(Login Kit + Content Posting API). Redirect URI:
# https://u-one-shot.vercel.app/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=

# MCP 서버 (app/api/mcp)
MCP_SHARED_SECRET=
MCP_OWNER_USER_ID=
GITHUB_TOKEN=
